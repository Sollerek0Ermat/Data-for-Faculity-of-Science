/**
 * 🛡️ Admin Dashboard
 */

let _subjects = [];
let _doctors  = [];
let _dws      = [];
let _userRole = 'user';

document.addEventListener('DOMContentLoaded', async () => {
  if (!Auth.requireAuth(['owner', 'moderator', 'doctor'])) return;

  renderTopbar();
  document.getElementById('footerPlaceholder').outerHTML = renderFooter();

  // ✅ Role الحالي
  const user = Auth.getUser();
  _userRole = user?.role || 'user';

  document.querySelectorAll('#adminTabs .tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('#adminTabs .tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.add('hidden'));
      tab.classList.add('active');
      document.getElementById('tab-' + tab.dataset.tab).classList.remove('hidden');
    });
  });

  try {
    _dws      = await API.getDoctorWithSubjects();
    _subjects = await API.getSubjects();
    _doctors  = await API.getDoctors();

    fillSelects();
    renderDoctorsList();
    renderSubjectsList();
  } catch (err) {
    console.error(err);
    UI.error(err.message || 'Failed to load data');
  }

  bindUpload();
  bindAddDoctor();
  bindAddSubject();

  // ✅ طبّق الصلاحيات
  applyRolePermissions();
});

/**
 * 🎯 إخفاء الأزرار حسب الـ Role
 * moderator: Add فقط
 * owner/doctor: Add + Edit + Delete
 */
function applyRolePermissions() {
  const isModerator = _userRole === 'moderator';

  if (isModerator) {
    // اخفي أزرار Edit/Delete
    document.querySelectorAll('[data-action="edit"], [data-action="delete"]').forEach(el => {
      el.style.display = 'none';
    });

    // أخفي أي عنصر فيه data-requires-role="doctor,owner"
    document.querySelectorAll('[data-requires-role="doctor,owner"]').forEach(el => {
      el.style.display = 'none';
    });

    console.log('🎯 Moderator mode: Add only');
  }

  // عرض الـ role في الصفحة
  const roleLabel = document.querySelector('.admin-role-label');
  if (roleLabel) {
    roleLabel.textContent = `Role: ${_userRole}`;
  }
}

function fillSelects() {
  const subjSel = document.getElementById('fileSubject');
  if (!subjSel) return;

  const prevSubj = subjSel.value;
  subjSel.innerHTML = '<option value="">Choose subject...</option>';
  _subjects.forEach(s => {
    const opt = document.createElement('option');
    opt.value = s.name;
    opt.textContent = '📚 ' + s.name;
    subjSel.appendChild(opt);
  });
  if (prevSubj) subjSel.value = prevSubj;

  updateDoctorsSelect();
  subjSel.addEventListener('change', updateDoctorsSelect);
}

function updateDoctorsSelect() {
  const subjName = document.getElementById('fileSubject').value;
  const docSel   = document.getElementById('fileDoctor');
  docSel.innerHTML = '';

  const list = subjName
    ? _dws.filter(d => d.subjects.some(s => s.name === subjName)).map(d => d.doctor)
    : _doctors;

  if (!list.length) {
    const opt = document.createElement('option');
    opt.value = '';
    opt.textContent = 'No doctors for this subject';
    docSel.appendChild(opt);
    return;
  }

  list.forEach(d => {
    const opt = document.createElement('option');
    opt.value = d.name;
    opt.textContent = d.name;
    docSel.appendChild(opt);
  });
}

function renderDoctorsList() {
  const wrap = document.getElementById('doctorsList');
  if (!wrap) return;

  if (!_doctors.length) {
    wrap.innerHTML = `<p class="text-muted text-center" style="padding:20px">No doctors</p>`;
    return;
  }

  const canEdit = _userRole === 'owner' || _userRole === 'doctor';

  wrap.innerHTML = _doctors.map(d => `
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid rgba(0,220,255,.1)">
      <div>
        <strong>${escapeHtml(d.name)}</strong>
        <div style="color:var(--muted);font-size:12px">
          ${escapeHtml(d.academicDegree || '')}
        </div>
      </div>
      ${canEdit ? `
        <button class="btn btn-danger btn-sm" data-action="delete" data-del-doc="${escapeHtml(d.name)}">🗑️</button>
      ` : ''}
    </div>
  `).join('');

  // Bind Delete
  if (canEdit) {
    wrap.querySelectorAll('[data-del-doc]').forEach(btn => {
      btn.addEventListener('click', () => {
        UI.info('Delete doctor — يحتاج تفعيل من الباك');
      });
    });
  }
}

function renderSubjectsList() {
  const wrap = document.getElementById('subjectsList');
  if (!wrap) return;

  if (!_subjects.length) {
    wrap.innerHTML = `<p class="text-muted text-center" style="padding:20px">No subjects</p>`;
    return;
  }

  const canEdit = _userRole === 'owner' || _userRole === 'doctor';

  wrap.innerHTML = _subjects.map(s => `
    <div style="display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid rgba(0,220,255,.1)">
      <div>
        <strong>📚 ${escapeHtml(s.name)}</strong>
        <div style="color:var(--muted);font-size:12px">${escapeHtml(s.code || '')}</div>
      </div>
      ${canEdit ? `
        <button class="btn btn-danger btn-sm" data-action="delete" data-del-subj="${escapeHtml(s.name)}">🗑️</button>
      ` : ''}
    </div>
  `).join('');

  // Bind Delete
  if (canEdit) {
    wrap.querySelectorAll('[data-del-subj]').forEach(btn => {
      btn.addEventListener('click', () => {
        UI.info('Delete subject — يحتاج تفعيل من الباك');
      });
    });
  }
}

function bindUpload() {
  const btn = document.getElementById('uploadBtn');
  if (!btn) return;

  btn.addEventListener('click', async () => {
    const title     = document.getElementById('fileTitle').value.trim();
    const type      = document.getElementById('fileType').value;
    const subject   = document.getElementById('fileSubject').value;
    const doctor    = document.getElementById('fileDoctor').value;
    const fileInput = document.getElementById('fileInput');
    const file      = fileInput.files[0];

    if (!title)   return UI.error('Enter file title');
    if (!subject) return UI.error('Choose subject');
    if (!doctor)  return UI.error('Choose doctor');
    if (!file)    return UI.error('Choose file');

    const fd = new FormData();
    const payload = {
      subjectName: subject,
      doctorName:  doctor,
      [type + 'Title']: title,
      [type + 'File']: 'file1',
    };

    fd.append('data', JSON.stringify([payload]));
    fd.append('file1', file);

    try {
      if (type === 'section')  await API.addSections(fd);
      if (type === 'summary')  await API.addSummaries(fd);
      if (type === 'resource') await API.addResources(fd);
      if (type === 'video')    await API.addVideos([payload]);

      UI.success('File uploaded successfully');
      document.getElementById('fileTitle').value = '';
      fileInput.value = '';
    } catch (err) {
      console.error(err);
      UI.error(err.message || 'Upload failed');
    }
  });
}

function bindAddDoctor() {
  const btn = document.getElementById('addDoctorBtn');
  if (!btn) return;

  btn.addEventListener('click', () => {
    // ⚠️ endpoint جديد — محتاج الباك يضيفه
    UI.info('Add doctor — يحتاج endpoint من الباك (/v1/owner/doctors/AddNewDoctors)');
  });
}

function bindAddSubject() {
  const btn = document.getElementById('addSubjectBtn');
  if (!btn) return;

  btn.addEventListener('click', () => {
    // ⚠️ endpoint جديد — محتاج الباك يضيفه
    UI.info('Add subject — يحتاج endpoint من الباك (/v1/owner/subjects/AddNewsubjects)');
  });
}