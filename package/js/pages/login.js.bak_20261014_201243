/**
 * 🔐 Login page — Microsoft OAuth
 */

document.addEventListener('DOMContentLoaded', async () => {
  if (document.getElementById('topbarPlaceholder')) renderTopbar();
  const footer = document.getElementById('footerPlaceholder');
  if (footer) footer.outerHTML = renderFooter();

  console.log('🔐 Login page loaded');
  console.log('Session:', Auth.getSession());

  // ═══════════════════════════════════════════
  // لو مسجّل بالفعل → وجهه للصفحة المناسبة
  // ═══════════════════════════════════════════
  if (Auth.isLoggedIn()) {
    console.log('✅ Already logged in → redirect');
    redirectByRole();
    return;
  }

  // ═══════════════════════════════════════════
  // حاول تجيب profile من الباك
  // ═══════════════════════════════════════════
  try {
    const profile = await API.getProfile();
    console.log('📋 Profile from server:', profile);

    if (profile && profile.role) {
      Auth.setSession({
        id:    profile.id,
        name:  profile.name,
        email: profile.email,
        role:  profile.role,
        photo: profile.photo,
      });

      redirectByRole();
      return;
    }
  } catch (err) {
    console.log('ℹ️ Not logged in:', err.message);
  }

  // ═══════════════════════════════════════════
  // ما حدش مسجّل → عرض Sign In button
  // ═══════════════════════════════════════════
  console.log('👤 Waiting for Sign in');

  const msBtn = document.getElementById('msLoginBtn');
  if (msBtn) {
    msBtn.addEventListener('click', () => {
      console.log('🪟 Redirect to Microsoft');
      window.location.href = CONFIG.API_URL + '/' + CONFIG.ENDPOINTS.student.microsoftLogin;
    });
  }
});

function redirectByRole() {
  const role = Auth.getRole();
  console.log('🎯 redirectByRole:', role);

  if (role === CONFIG.ROLES.OWNER ||
      role === CONFIG.ROLES.MODERATOR ||
      role === CONFIG.ROLES.DOCTOR) {
    console.log('→ admin.html');
    window.location.href = 'admin.html';
  } else {
    // طالب → intro
    const introSeen = sessionStorage.getItem('intro_seen');
    if (!introSeen) {
      sessionStorage.setItem('intro_seen', '1');
      console.log('→ intro.html');
      window.location.href = 'intro.html';
    } else {
      console.log('→ index.html');
      window.location.href = 'index.html';
    }
  }
}