/**
 * Admin Dashboard
 */

let _subjects = [];
let _doctors  = [];
let _dws      = [];
let _userRole = "user";

document.addEventListener("DOMContentLoaded", async () => {
  if (!Auth.requireAuth(["owner", "moderator", "doctor"])) return;

  renderTopbar('admin.html');
  const footer = document.getElementById("footerPlaceholder");
  if (footer) footer.outerHTML = renderFooter();

  const user = Auth.getUser();
  _userRole = (user && user.role) ? user.role : "user";

  document.querySelectorAll("#adminTabs .tab").forEach(function(tab) {
    tab.addEventListener("click", function() {
      document.querySelectorAll("#adminTabs .tab").forEach(function(t) {
        t.classList.remove("active");
      });
      document.querySelectorAll(".tab-content").forEach(function(c) {
        c.classList.add("hidden");
      });
      tab.classList.add("active");
      const target = document.getElementById("tab-" + tab.dataset.tab);
      if (target) target.classList.remove("hidden");
    });
  });

  try {
    _dws      = await API.getDoctorWithSubjects();
    _subjects = await API.getSubjects();
    _doctors  = await API.getDoctors();

    await loadDoctorsDetails();

    fillSelects();
    renderDoctorsList();
    renderSubjectsList();
  } catch (err) {
    console.error(err);
    UI.error(err.message || "Failed to load data");
  }

  bindUpload();
  bindAddDoctor();
  bindAddSubject();

  applyRolePermissions();
});

async function loadDoctorsDetails() {
  if (!_doctors.length) return;

  try {
    const details = await Promise.all(
      _doctors.map(function(d) {
        return API.getFolderInfo("doctor", d.name).catch(function() { return null; });
      })
    );

    _doctors = _doctors.map(function(d, i) {
      const info = details[i];
      if (info) {
        d.academicDegree = info.doctorAcademicDegree || d.academicDegree || "";
        d.description    = info.doctorDescription   || d.description    || "";
        d.certifications = info.doctorCertifications || d.certifications || [];
      }
      return d;
    });

    console.log("Doctors loaded with details:", _doctors);
  } catch (err) {
    console.warn("Failed to load doctor details:", err.message);
  }
}

function applyRolePermissions() {
  const isModerator = _userRole === "moderator";

  if (isModerator) {
    document.querySelectorAll("[data-action='edit'], [data-action='delete']").forEach(function(el) {
      el.style.display = "none";
    });
    console.log("Moderator mode: Add only");
  }
}

function fillSelects() {
  const subjSel = document.getElementById("fileSubject");
  if (!subjSel) return;

  const prevSubj = subjSel.value;
  subjSel.innerHTML = "<option value=''>Choose subject...</option>";
  _subjects.forEach(function(s) {
    const opt = document.createElement("option");
    opt.value = s.name;
    opt.textContent = "Book: " + s.name;
    subjSel.appendChild(opt);
  });
  if (prevSubj) subjSel.value = prevSubj;

  updateDoctorsSelect();
  subjSel.addEventListener("change", updateDoctorsSelect);
}

function updateDoctorsSelect() {
  const subjName = document.getElementById("fileSubject").value;
  const docSel   = document.getElementById("fileDoctor");
  if (!docSel) return;

  docSel.innerHTML = "";

  const list = subjName
    ? _dws.filter(function(d) {
        return d.subjects.some(function(s) { return s.name === subjName; });
      }).map(function(d) { return d.doctor; })
    : _doctors;

  if (!list.length) {
    const opt = document.createElement("option");
    opt.value = "";
    opt.textContent = "No doctors for this subject";
    docSel.appendChild(opt);
    return;
  }

  list.forEach(function(d) {
    const opt = document.createElement("option");
    opt.value = d.name;
    opt.textContent = d.name;
    docSel.appendChild(opt);
  });
}

function renderDoctorsList() {
  const wrap = document.getElementById("doctorsList");
  if (!wrap) return;

  if (!_doctors.length) {
    wrap.innerHTML = "<p class='text-muted text-center' style='padding:20px'>No doctors</p>";
    return;
  }

  const canEdit = _userRole === "owner" || _userRole === "doctor";

  const html = _doctors.map(function(d) {
    const degree = escapeHtml(d.academicDegree || "");
    const desc   = escapeHtml(d.description || "");
    const name   = escapeHtml(d.name);
    const deleteBtn = canEdit 
      ? "<button class='btn btn-danger btn-sm' data-action='delete' data-del-doc='" + name + "'>Delete</button>" 
      : "";

    return [
      "<div style='display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid rgba(0,220,255,.1)'>",
      "<div>",
      "<strong>" + name + "</strong>",
      "<div style='color:var(--muted);font-size:12px'>",
      degree + (desc ? " - " + desc : ""),
      "</div>",
      "</div>",
      deleteBtn,
      "</div>"
    ].join("");
  }).join("");

  wrap.innerHTML = html;

  if (canEdit) {
    wrap.querySelectorAll("[data-del-doc]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        deleteDoctor(btn.dataset.delDoc);
      });
    });
  }
}

function renderSubjectsList() {
  const wrap = document.getElementById("subjectsList");
  if (!wrap) return;

  if (!_subjects.length) {
    wrap.innerHTML = "<p class='text-muted text-center' style='padding:20px'>No subjects</p>";
    return;
  }

  const canEdit = _userRole === "owner" || _userRole === "doctor";

  const html = _subjects.map(function(s) {
    const name = escapeHtml(s.name);
    const code = escapeHtml(s.code || "");
    const deleteBtn = canEdit 
      ? "<button class='btn btn-danger btn-sm' data-action='delete' data-del-subj='" + name + "'>Delete</button>" 
      : "";

    return [
      "<div style='display:flex;justify-content:space-between;align-items:center;padding:12px;border-bottom:1px solid rgba(0,220,255,.1)'>",
      "<div>",
      "<strong>" + name + "</strong>",
      "<div style='color:var(--muted);font-size:12px'>" + code + "</div>",
      "</div>",
      deleteBtn,
      "</div>"
    ].join("");
  }).join("");

  wrap.innerHTML = html;

  if (canEdit) {
    wrap.querySelectorAll("[data-del-subj]").forEach(function(btn) {
      btn.addEventListener("click", function() {
        deleteSubject(btn.dataset.delSubj);
      });
    });
  }
}

async function deleteDoctor(name) {
  if (!confirm("Delete doctor: " + name + "?")) return;

  try {
    await API.deleteDoctors(name);
    UI.success("Doctor deleted");
    _doctors = _doctors.filter(function(d) { return d.name !== name; });
    renderDoctorsList();
    updateDoctorsSelect();
  } catch (err) {
    console.error(err);
    UI.error(err.message || "Delete failed");
  }
}

async function deleteSubject(name) {
  if (!confirm("Delete subject: " + name + "?")) return;

  try {
    // ⚡ الباك محتاج DepartmentName + levelNumber + semesterNumber + subjectName
    await API.deleteSubjects([{
      DepartmentName: CONFIG.DEFAULTS.department,
      levelNumber:    CONFIG.DEFAULTS.levelNumber,
      semesterNumber: CONFIG.DEFAULTS.semesterNumber,
      subjectName:    name
    }]);
    UI.success("Subject deleted");
    _subjects = _subjects.filter(function(s) { return s.name !== name; });
    renderSubjectsList();
    fillSelects();
  } catch (err) {
    console.error(err);
    UI.error(err.message || "Delete failed");
  }
}

function bindUpload() {
  const btn = document.getElementById("uploadBtn");
  if (!btn) return;

  btn.addEventListener("click", async function() {
    const title     = document.getElementById("fileTitle").value.trim();
    const type      = document.getElementById("fileType").value;
    const subject   = document.getElementById("fileSubject").value;
    const doctor    = document.getElementById("fileDoctor").value;
    const fileInput = document.getElementById("fileInput");
    const file      = fileInput.files[0];

    if (!title)   return UI.error("Enter file title");
    if (!subject) return UI.error("Choose subject");
    if (!doctor)  return UI.error("Choose doctor");
    if (!file)    return UI.error("Choose file");

    const fd = new FormData();
    const payload = {};
    payload.subjectName = subject;
    payload.doctorName  = doctor;
    payload[type + "Title"] = title;
    payload[type + "File"]  = "file1";

    fd.append("data", JSON.stringify([payload]));
    fd.append("file1", file);

    try {
      if (type === "section")  await API.addSections(fd);
      if (type === "summary")  await API.addSummaries(fd);
      if (type === "resource") await API.addResources(fd);
      if (type === "video")    await API.addVideos([payload]);

      UI.success("File uploaded successfully");
      document.getElementById("fileTitle").value = "";
      fileInput.value = "";
    } catch (err) {
      console.error(err);
      UI.error(err.message || "Upload failed");
    }
  });
}

function bindAddDoctor() {
  const btn = document.getElementById("addDoctorBtn");
  if (!btn) return;

  btn.addEventListener("click", function() {
    UI.info("Add doctor - needs backend endpoint");
  });
}

function bindAddSubject() {
  const btn = document.getElementById("addSubjectBtn");
  if (!btn) return;

  btn.addEventListener("click", async function() {
    const name = document.getElementById("subjectName").value.trim();

    if (!name) return UI.error("Enter subject name");

    const payload = [{
      subjectName: name,
      subjectDescription: "",
      DepartmentName: CONFIG.DEFAULTS.department,
      levelNumber: CONFIG.DEFAULTS.levelNumber,
      semesterNumber: CONFIG.DEFAULTS.semesterNumber,
    }];

    try {
      await API.addSubjects(payload);
      UI.success("Subject added");
      _subjects = await API.getSubjects();
      renderSubjectsList();
      fillSelects();
      document.getElementById("subjectName").value = "";
    } catch (err) {
      console.error(err);
      UI.error(err.message || "Add failed");
    }
  });
}
