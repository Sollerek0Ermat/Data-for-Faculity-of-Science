const API = (function() {

  async function request(path, options) {
    options = options || {};
    const method = options.method || "GET";
    const body = options.body;
    const isFormData = options.isFormData || false;

    const url = CONFIG.API_URL
      ? CONFIG.API_URL.replace(/\/$/, "") + "/" + path.replace(/^\//, "")
      : path;

    const headers = {};
    if (!isFormData && body) headers["Content-Type"] = "application/json";

    const fetchOptions = {
      method: method,
      headers: headers,
      credentials: "include"
    };
    if (body) fetchOptions.body = isFormData ? body : JSON.stringify(body);

    let res;
    try {
      res = await fetch(url, fetchOptions);
    } catch (netErr) {
      console.error("[API] Network error:", netErr);
      throw new Error("Cannot reach server");
    }

    if (res.status === 401) {
      Auth.clearSession();
      if (location.pathname.indexOf("login.html") === -1) {
        window.location.href = "login.html";
      }
      throw new Error("Unauthorized");
    }

    const ctype = res.headers.get("content-type") || "";
    if (ctype.indexOf("application/json") === -1) {
      if (!res.ok) throw new Error("HTTP " + res.status);
      return await res.blob();
    }

    const data = await res.json().catch(function() { return null; });

    if (!res.ok) {
      const msg = (data && (data.message || data.error)) || ("HTTP " + res.status);
      throw new Error(msg);
    }

    return data;
  }

  const ep = CONFIG.ENDPOINTS;

  /* Student */
  async function getProfile() {
    const res = await request(ep.student.profile);
    return Mappers.profile(res.data);
  }

  function getProfilePhotoUrl(userId) {
    return CONFIG.API_URL + "/" + ep.student.profilePhoto + "/" + userId;
  }

  async function getFolders(query) {
    const res = await request(buildUrl(ep.student.folders, query || {}));
    return res.data || [];
  }

  async function getFolderInfo(folder, folderName) {
    const res = await request(
      ep.student.folderInfo + "/" + folder + "/" + encodeURIComponent(folderName)
    );
    return res.data || null;
  }

  async function getDoctorWithSubjects() {
    const res = await request(ep.student.doctorWithSubjects);
    return Mappers.doctorWithSubjects(res.data);
  }

  function getDoctorPhotoUrl(doctorName) {
    return CONFIG.API_URL + "/" + ep.student.doctorPhoto + "/" + encodeURIComponent(doctorName);
  }

  function getDoctorCertificationUrl(doctorName, n) {
    return CONFIG.API_URL + "/" + ep.student.doctorCertifications + "/" + encodeURIComponent(doctorName) + "/" + n;
  }

  async function getSubjects() {
    const dws = await getDoctorWithSubjects();
    const map = new Map();
    dws.forEach(function(item) {
      (item.subjects || []).forEach(function(s) {
        if (!map.has(s.name)) {
          map.set(s.name, {
            id:          s.name,
            name:        s.name,
            code:        s.code || '',
            description: s.description || s.subjectDescription || '',
            icon:        '📚'
          });
        }
      });
    });
    return Array.from(map.values()).sort(function(a, b) {
      return a.name.localeCompare(b.name);
    });
  }

  async function getDoctors() {
    const dws = await getDoctorWithSubjects();
    return dws.map(function(d) { return d.doctor; });
  }

  async function getFolderContent(opts) {
    // ⚡ توحيد resource/recourse
    let dataType = opts.dataType;
    if (dataType === 'resource') dataType = 'resource'; // نبعت resource زي ما هو
    // الباك بيستقبل "resource" في الرابط

    const query = {
      department:     CONFIG.DEFAULTS.department,
      levelNumber:    CONFIG.DEFAULTS.levelNumber,
      semesterNumber: opts.semesterNumber || CONFIG.DEFAULTS.semesterNumber,
      subject:        opts.subjectName,
      doctor:         opts.doctorName,
      dataType:       dataType
    };
    const res = await request(buildUrl(ep.student.folders, query));
    return res.data || [];
  }

  function downloadFile(dataType, dataName, mode) {
    mode = mode || "view";
    // ⚡ الباك بيستخدم "resource" في downloadFile
    let dt = dataType === 'recourse' ? 'resource' : dataType;
    
    const url = CONFIG.API_URL + "/" +
      ep.student.download + "/" +
      dt + "/" +
      encodeURIComponent(dataName) +
      "/download?mode=" + mode;

    if (mode === "view") {
      window.open(url, "_blank");
    } else {
      const a = document.createElement("a");
      a.href = url;
      a.download = dataName;
      document.body.appendChild(a);
      a.click();
      a.remove();
    }
  }

  async function adminLogin(opts) {
    await request(ep.admin.login, {
      method: "POST",
      body: { password: opts.password }
    });
    const profile = await getProfile();
    return {
      success: true,
      session: {
        email: (profile && profile.email) || opts.email,
        name:  (profile && profile.name)  || "Admin",
        role:  (profile && profile.role)  || "user"
      }
    };
  }

  async function adminLogout() {
    return await request(ep.admin.logout, { method: "POST" });
  }

  async function changePassword(opts) {
    return await request(ep.admin.changePassword, {
      method: "PATCH",
      body: {
        old_password:     opts.oldPassword,
        password:         opts.password,
        confirm_password: opts.confirm_password
      }
    });
  }

  /* Moderator - Sections */
  async function addSections(formData) {
    return await request(ep.moderator.addSections, { method: "POST", body: formData, isFormData: true });
  }
  async function deleteSections(sectionTitle) {
    return await request(ep.moderator.deleteSections, { method: "DELETE", body: { sectionTitle: sectionTitle } });
  }
  async function editSection(formData) {
    return await request(ep.moderator.editSection, { method: "PATCH", body: formData, isFormData: true });
  }

  /* Moderator - Videos */
  async function addVideos(payload) {
    return await request(ep.moderator.addVideos, { method: "POST", body: payload });
  }
  async function deleteVideos(videoTitle) {
    return await request(ep.moderator.deleteVideos, { method: "DELETE", body: { videoTitle: videoTitle } });
  }
  async function editVideo(payload) {
    return await request(ep.moderator.editVideo, { method: "PATCH", body: payload });
  }

  /* Moderator - Resources */
  async function addResources(formData) {
    return await request(ep.moderator.addResources, { method: "POST", body: formData, isFormData: true });
  }
  async function deleteResources(resourceTitle) {
    return await request(ep.moderator.deleteResources, { method: "DELETE", body: { resourceTitle: resourceTitle } });
  }
  async function editResource(formData) {
    return await request(ep.moderator.editResource, { method: "PATCH", body: formData, isFormData: true });
  }

  /* Moderator - Summaries */
  async function addSummaries(formData) {
    return await request(ep.moderator.addSummaries, { method: "POST", body: formData, isFormData: true });
  }
  async function deleteSummaries(summaryTitle) {
    return await request(ep.moderator.deleteSummaries, { method: "DELETE", body: { summaryTitle: summaryTitle } });
  }
  async function editSummary(formData) {
    return await request(ep.moderator.editSummary, { method: "PATCH", body: formData, isFormData: true });
  }

  /* Owner - Doctors */
  async function addDoctors(formData) {
    return await request(ep.owner.addDoctors, { method: "POST", body: formData, isFormData: true });
  }
  async function deleteDoctors(doctorNames) {
    return await request(ep.owner.deleteDoctors, {
      method: "DELETE",
      body: { doctorName: Array.isArray(doctorNames) ? doctorNames : [doctorNames] }
    });
  }
  async function editDoctor(formData) {
    return await request(ep.owner.editDoctor, { method: "PATCH", body: formData, isFormData: true });
  }

  /* Owner - Subjects */
  async function addSubjects(payload) {
    return await request(ep.owner.addSubjects, { method: "POST", body: payload });
  }
  async function deleteSubjects(payload) {
    return await request(ep.owner.deleteSubjects, { method: "DELETE", body: payload });
  }
  async function editSubject(payload) {
    return await request(ep.owner.editSubject, { method: "PATCH", body: payload });
  }

  /* Owner - Departments */
  async function addDepartments(payload) {
    return await request(ep.owner.addDepartments, { method: "POST", body: payload });
  }
  async function deleteDepartments(names) {
    return await request(ep.owner.deleteDepartments, {
      method: "DELETE",
      body: { departmentsName: Array.isArray(names) ? names : [names] }
    });
  }
  async function editDepartment(payload) {
    return await request(ep.owner.editDepartment, { method: "PATCH", body: payload });
  }

  /* Owner - Levels & Semesters */
  async function addLevels(payload) {
    return await request(ep.owner.addLevels, { method: "POST", body: payload });
  }
  async function deleteLevels(payload) {
    return await request(ep.owner.deleteLevels, { method: "DELETE", body: payload });
  }
  async function addSemesters(payload) {
    return await request(ep.owner.addSemesters, { method: "POST", body: payload });
  }
  async function deleteSemesters(payload) {
    return await request(ep.owner.deleteSemesters, { method: "DELETE", body: payload });
  }

  /* Owner - Link/Unlink */
  async function linkDoctors(payload) {
    return await request(ep.owner.linkDoctors, { method: "POST", body: payload });
  }
  async function unlinkDoctors(payload) {
    return await request(ep.owner.unlinkDoctors, { method: "DELETE", body: payload });
  }

  /* Owner - Roles & Lock */
  async function garanteeRoles(payload) {
    return await request(ep.owner.garanteeRoles, { method: "PATCH", body: payload });
  }
  async function changeLock(payload) {
    return await request(ep.owner.changeLock, { method: "PATCH", body: payload });
  }

  function buildUrl(path, params) {
    params = params || {};
    const qs = new URLSearchParams();
    Object.keys(params).forEach(function(k) {
      const v = params[k];
      if (v !== undefined && v !== null && v !== "") qs.append(k, v);
    });
    const q = qs.toString();
    return q ? (path + "?" + q) : path;
  }

  return {
    request: request,
    getProfile: getProfile,
    getProfilePhotoUrl: getProfilePhotoUrl,
    getFolders: getFolders,
    getFolderInfo: getFolderInfo,
    getDoctorWithSubjects: getDoctorWithSubjects,
    getDoctorPhotoUrl: getDoctorPhotoUrl,
    getDoctorCertificationUrl: getDoctorCertificationUrl,
    getSubjects: getSubjects,
    getDoctors: getDoctors,
    getFolderContent: getFolderContent,
    downloadFile: downloadFile,
    adminLogin: adminLogin,
    adminLogout: adminLogout,
    changePassword: changePassword,
    addSections: addSections,
    deleteSections: deleteSections,
    editSection: editSection,
    addVideos: addVideos,
    deleteVideos: deleteVideos,
    editVideo: editVideo,
    addResources: addResources,
    deleteResources: deleteResources,
    editResource: editResource,
    addSummaries: addSummaries,
    deleteSummaries: deleteSummaries,
    editSummary: editSummary,
    addDoctors: addDoctors,
    deleteDoctors: deleteDoctors,
    editDoctor: editDoctor,
    addSubjects: addSubjects,
    deleteSubjects: deleteSubjects,
    editSubject: editSubject,
    addDepartments: addDepartments,
    deleteDepartments: deleteDepartments,
    editDepartment: editDepartment,
    addLevels: addLevels,
    deleteLevels: deleteLevels,
    addSemesters: addSemesters,
    deleteSemesters: deleteSemesters,
    linkDoctors: linkDoctors,
    unlinkDoctors: unlinkDoctors,
    garanteeRoles: garanteeRoles,
    changeLock: changeLock
  };
})();
